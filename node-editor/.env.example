# Replicate API token — get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override default models
# Image: any text-to-image model on Replicate
IMAGE_MODEL=black-forest-labs/flux-schnell

# Video: any text-to-video or image-to-video model on Replicate
VIDEO_MODEL=minimax/video-01

# Server port (frontend dev server proxies /api to here)
PORT=3001
