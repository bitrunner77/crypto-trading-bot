# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (defaults shown)
# AI_MODEL_OPUS=claude-opus-4-7
# AI_MODEL_HAIKU=claude-haiku-4-5-20251001
# AI_ESCALATE_THRESHOLD=0.55     # Min Haiku signal_strength to call Opus

# ── Web Dashboard ──────────────────────────────────────────────────────────────
# Loopback by default. Set HOST=0.0.0.0 to expose on the network — and SET A TOKEN.
# WEB_DASHBOARD_HOST=127.0.0.1
# WEB_DASHBOARD_PORT=8080
# WEB_DASHBOARD_TOKEN=             # if set, ?token=... required on / and /ws
# WEB_DASHBOARD_ENABLED=true       # set to false to disable the server entirely

# ── Exchange ───────────────────────────────────────────────────────────────────
EXCHANGE=binance               # ccxt exchange id: binance, coinbase, kraken, bybit
EXCHANGE_API_KEY=your_api_key
EXCHANGE_API_SECRET=your_api_secret

# ── Trading ────────────────────────────────────────────────────────────────────
TRADING_MODE=paper             # paper | live
TRADING_PAIRS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT  # Perpetual futures
STRATEGY=ai_driven             # ai_driven | momentum | mean_reversion | grid | dca
TIMEFRAME=1h                   # 1m | 5m | 15m | 1h | 4h | 1d
LOOP_INTERVAL_SECONDS=60       # How often the main loop runs

# ── Paper Trading ──────────────────────────────────────────────────────────────
PAPER_INITIAL_BALANCE=10000.0  # Starting USDT balance for paper trading
PAPER_SLIPPAGE_PCT=0.001       # Simulated slippage (0.1%)

# ── Leverage ───────────────────────────────────────────────────────────────────
MAX_LEVERAGE=20                # Hard cap: max 20x leverage per trade

# ── Risk Management ────────────────────────────────────────────────────────────
RISK_MAX_POSITION_PCT=0.50     # Max 50% of remaining budget per trade (rule)
RISK_MAX_DRAWDOWN_PCT=0.90     # Halt only near wipeout; $0 check is primary gate
RISK_STOP_LOSS_PCT=0.03        # 3% stop loss per trade
RISK_TAKE_PROFIT_PCT=0.06      # 6% take profit per trade
RISK_MAX_DAILY_LOSS_PCT=0.50   # Aggressive growth — wide daily limit

# ── Grid Strategy ──────────────────────────────────────────────────────────────
GRID_LEVELS=10
GRID_SPREAD_PCT=0.01           # 1% between grid levels

# ── DCA Strategy ───────────────────────────────────────────────────────────────
DCA_INTERVAL_HOURS=24
DCA_AMOUNT_USDT=100.0

# ── Backtesting ────────────────────────────────────────────────────────────────
BACKTEST_START=2024-01-01
BACKTEST_END=2024-12-31

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
